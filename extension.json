{
  "name": "UnifiedExtensionForFemiwiki",
  "version": "5.0.0",
  "author": "[https://femiwiki.com/ Femiwiki Team]",
  "url": "https://github.com/femiwiki/unifiedExtensionForFemiwiki",
  "descriptionmsg": "unifiedextensionforfemiwiki-desc",
  "license-name": "AGPL-3.0-or-later",
  "type": "specialpage",
  "requires": {
    "MediaWiki": ">= 1.46.0",
    "extensions": {
      "CategoryTree": "*",
      "SpamBlacklist": "*",
      "Echo": "*"
    }
  },
  "AutoloadNamespaces": {
    "MediaWiki\\Extension\\UnifiedExtensionForFemiwiki\\": "includes/"
  },
  "AuthManagerAutoConfig": {
    "preauth": {
      "FemiwikiPreAuthenticationProvider": {
        "class": "MediaWiki\\Extension\\UnifiedExtensionForFemiwiki\\FemiwikiPreAuthenticationProvider"
      }
    }
  },
  "HookHandlers": {
    "main": {
      "class": "MediaWiki\\Extension\\UnifiedExtensionForFemiwiki\\HookHandlers\\Main",
      "services": ["MainConfig"]
    },
    "DefaultOptions": {
      "class": "MediaWiki\\Extension\\UnifiedExtensionForFemiwiki\\HookHandlers\\DefaultOptions",
      "services": ["MainConfig", "UserOptionsManager"]
    },
    "SpamEmail": {
      "class": "MediaWiki\\Extension\\UnifiedExtensionForFemiwiki\\HookHandlers\\SpamEmail",
      "services": [
        "MainConfig",
        "DBLoadBalancer",
        "DatabaseBlockStore",
        "MainWANObjectCache"
      ]
    },
    "Services": {
      "class": "MediaWiki\\Extension\\UnifiedExtensionForFemiwiki\\HookHandlers\\Services"
    },
    "GrowthMessages": {
      "class": "MediaWiki\\Extension\\UnifiedExtensionForFemiwiki\\HookHandlers\\GrowthMessages"
    },
    "GrowthTopics": {
      "class": "MediaWiki\\Extension\\UnifiedExtensionForFemiwiki\\HookHandlers\\GrowthTopics"
    },
    "ManualNotification": {
      "class": "MediaWiki\\Extension\\UnifiedExtensionForFemiwiki\\HookHandlers\\ManualNotification"
    }
  },
  "Hooks": {
    "BeforeCreateEchoEvent": "ManualNotification",
    "HtmlPageLinkRendererBegin": "main",
    "isValidEmailAddr": "SpamEmail",
    "LinkerMakeExternalLink": "main",
    "MediaWikiServices": "Services",
    "MessageCacheFetchOverrides": "GrowthMessages",
    "SidebarBeforeOutput": "main",
    "SkinAddFooterLinks": "main",
    "UserGetDefaultOptions": "GrowthTopics",
    "UserMailerTransformContent": "main"
  },
  "SpecialPages": {
    "WriteManualNotification": {
      "class": "MediaWiki\\Extension\\UnifiedExtensionForFemiwiki\\Special\\SpecialWriteManualNotification",
      "services": [
        "UserGroupManager",
        "ConnectionProvider",
        "JobQueueGroup",
        "MainObjectStash"
      ]
    }
  },
  "JobClasses": {
    "writeManualNotification": {
      "class": "MediaWiki\\Extension\\UnifiedExtensionForFemiwiki\\ManualNotification\\ManualNotificationJob",
      "services": ["NotificationService", "ConnectionProvider", "JobQueueGroup"],
      "needsPage": false
    }
  },
  "AvailableRights": ["writemanualnotification"],
  "GroupPermissions": {
    "sysop": {
      "writemanualnotification": true
    }
  },
  "LogTypes": ["manualnotification"],
  "LogActionsHandlers": {
    "manualnotification/*": "MediaWiki\\Logging\\LogFormatter"
  },
  "DefaultUserOptions": {
    "echo-subscriptions-email-write-manual-notification": false
  },
  "MessagesDirs": {
    "UnifiedExtensionForFemiwiki": ["i18n"]
  },
  "ExtensionMessagesFiles": {
    "UnifiedExtensionForFemiwikiAlias": "UnifiedExtensionForFemiwiki.i18n.alias.php"
  },
  "attributes": {
    "CommunityConfiguration": {
      "Providers": {
        "FemiwikiSuggestedEditsTopics": {
          "store": {
            "type": "wikipage",
            "args": ["MediaWiki:FemiwikiSuggestedEditsTopics.json"]
          },
          "validator": {
            "type": "jsonschema",
            "args": ["MediaWiki\\Extension\\UnifiedExtensionForFemiwiki\\GrowthExperiments\\TopicsSchema"]
          },
          "type": "data"
        }
      }
    }
  },
  "config": {
    "UnifiedExtensionForFemiwikiPreAuth": {
      "value": false,
      "description": "If set to true, creating account would require an additional step."
    },
    "UnifiedExtensionForFemiwikiModifyEmailTheme": {
      "value": false,
      "description": "Modifies the email theme to use the femiwiki theme."
    },
    "UnifiedExtensionForFemiwikiBlockByEmail": {
      "value": true,
      "description": "Block emails used by block users"
    },
    "UnifiedExtensionForFemiwikiSuggestedEdits": {
      "value": false,
      "description": "Finds GrowthExperiments suggested edits with database queries, without CirrusSearch or WikimediaMessages."
    },
    "UnifiedExtensionForFemiwikiManualNotificationBatchSize": {
      "value": 500,
      "description": "How many users one job of Special:WriteManualNotification notifies before queueing the next."
    }
  },
  "TestAutoloadNamespaces": {
    "MediaWiki\\Extension\\UnifiedExtensionForFemiwiki\\Tests\\Unit\\": "tests/phpunit/unit/",
    "MediaWiki\\Extension\\UnifiedExtensionForFemiwiki\\Tests\\Integration\\": "tests/phpunit/integration/"
  },
  "manifest_version": 2
}
