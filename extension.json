{
  "name": "UnifiedExtensionForFemiwiki",
  "version": "5.0.0",
  "author": "[https://femiwiki.com/ Femiwiki Team]",
  "url": "https://github.com/femiwiki/unifiedExtensionForFemiwiki",
  "descriptionmsg": "unifiedextensionforfemiwiki-desc",
  "license-name": "AGPL-3.0-or-later",
  "type": "specialpage",
  "requires": {
    "MediaWiki": ">= 1.46.0",
    "extensions": {
      "CategoryTree": "*",
      "SpamBlacklist": "*",
      "Echo": "*"
    }
  },
  "AutoloadNamespaces": {
    "MediaWiki\\Extension\\UnifiedExtensionForFemiwiki\\": "includes/"
  },
  "AuthManagerAutoConfig": {
    "preauth": {
      "FemiwikiPreAuthenticationProvider": {
        "class": "MediaWiki\\Extension\\UnifiedExtensionForFemiwiki\\FemiwikiPreAuthenticationProvider"
      }
    }
  },
  "HookHandlers": {
    "main": {
      "class": "MediaWiki\\Extension\\UnifiedExtensionForFemiwiki\\HookHandlers\\Main",
      "services": ["MainConfig"]
    },
    "DefaultOptions": {
      "class": "MediaWiki\\Extension\\UnifiedExtensionForFemiwiki\\HookHandlers\\DefaultOptions",
      "services": ["MainConfig", "UserOptionsManager"]
    },
    "SpamEmail": {
      "class": "MediaWiki\\Extension\\UnifiedExtensionForFemiwiki\\HookHandlers\\SpamEmail",
      "services": [
        "MainConfig",
        "DBLoadBalancer",
        "DatabaseBlockStore",
        "MainWANObjectCache"
      ]
    },
    "Services": {
      "class": "MediaWiki\\Extension\\UnifiedExtensionForFemiwiki\\HookHandlers\\Services"
    },
    "GrowthMessages": {
      "class": "MediaWiki\\Extension\\UnifiedExtensionForFemiwiki\\HookHandlers\\GrowthMessages"
    },
    "GrowthTopics": {
      "class": "MediaWiki\\Extension\\UnifiedExtensionForFemiwiki\\HookHandlers\\GrowthTopics"
    },
    "ManualNotification": {
      "class": "MediaWiki\\Extension\\UnifiedExtensionForFemiwiki\\HookHandlers\\ManualNotification"
    },
    "NumberOfEmails": {
      "class": "MediaWiki\\Extension\\UnifiedExtensionForFemiwiki\\HookHandlers\\NumberOfEmails",
      "services": ["ConnectionProvider", "MainWANObjectCache", "MagicWordFactory"]
    },
    "RankingAchievement": {
      "class": "MediaWiki\\Extension\\UnifiedExtensionForFemiwiki\\HookHandlers\\RankingAchievement",
      "services": ["MainConfig", "PermissionManager", "SpecialPageFactory", "TitleFactory", "UserFactory"]
    },
    "ShareCard": {
      "class": "MediaWiki\\Extension\\UnifiedExtensionForFemiwiki\\HookHandlers\\ShareCard",
      "services": ["MainConfig", "PageProps", "NamespaceInfo", "UrlUtils"]
    },
    "TranslatedPages": {
      "class": "MediaWiki\\Extension\\UnifiedExtensionForFemiwiki\\HookHandlers\\TranslatedPages"
    }
  },
  "Hooks": {
    "BeforeCreateAchievement": "RankingAchievement",
    "BeforeCreateEchoEvent": "ManualNotification",
    "BeforePageDisplay": ["ShareCard", "TranslatedPages"],
    "GetMagicVariableIDs": "NumberOfEmails",
    "HtmlPageLinkRendererBegin": "main",
    "isValidEmailAddr": "SpamEmail",
    "LinkerMakeExternalLink": "main",
    "LinksUpdateComplete": "RankingAchievement",
    "MediaWikiServices": "Services",
    "MessageCacheFetchOverrides": "GrowthMessages",
    "ParserFirstCallInit": "NumberOfEmails",
    "ParserGetVariableValueSwitch": "NumberOfEmails",
    "SidebarBeforeOutput": "main",
    "SkinAddFooterLinks": "main",
    "SpecialStatsAddExtra": "NumberOfEmails",
    "UserGetDefaultOptions": "GrowthTopics",
    "UserMailerTransformContent": "main"
  },
  "SpecialPages": {
    "Export": {
      "class": "MediaWiki\\Extension\\UnifiedExtensionForFemiwiki\\Special\\SpecialExportWithTimeLimit",
      "services": ["ConnectionProvider", "WikiExporterFactory", "TitleFormatter", "LinksMigration"]
    },
    "WriteManualNotification": {
      "class": "MediaWiki\\Extension\\UnifiedExtensionForFemiwiki\\Special\\SpecialWriteManualNotification",
      "services": [
        "UserGroupManager",
        "ConnectionProvider",
        "JobQueueGroup",
        "MainObjectStash"
      ]
    }
  },
  "RestRoutes": [
    {
      "path": "/femiwiki/v1/share-card/{revision}",
      "method": "GET",
      "class": "MediaWiki\\Extension\\UnifiedExtensionForFemiwiki\\ShareCard\\ShareCardHandler",
      "services": ["MainConfig", "RevisionLookup", "NamespaceInfo", "TitleFormatter", "ShellCommandFactory"]
    }
  ],
  "JobClasses": {
    "writeManualNotification": {
      "class": "MediaWiki\\Extension\\UnifiedExtensionForFemiwiki\\ManualNotification\\ManualNotificationJob",
      "services": ["NotificationService", "ConnectionProvider", "JobQueueGroup"],
      "needsPage": false
    }
  },
  "AvailableRights": ["writemanualnotification"],
  "GroupPermissions": {
    "sysop": {
      "writemanualnotification": true
    }
  },
  "LogTypes": ["manualnotification"],
  "LogActionsHandlers": {
    "manualnotification/*": "MediaWiki\\Logging\\LogFormatter"
  },
  "DefaultUserOptions": {
    "echo-subscriptions-email-write-manual-notification": false
  },
  "MessagesDirs": {
    "UnifiedExtensionForFemiwiki": ["i18n"]
  },
  "ExtensionMessagesFiles": {
    "UnifiedExtensionForFemiwikiAlias": "UnifiedExtensionForFemiwiki.i18n.alias.php",
    "UnifiedExtensionForFemiwikiMagic": "UnifiedExtensionForFemiwiki.i18n.magic.php"
  },
  "attributes": {
    "CommunityConfiguration": {
      "Providers": {
        "FemiwikiSuggestedEditsTopics": {
          "store": {
            "type": "wikipage",
            "args": ["MediaWiki:FemiwikiSuggestedEditsTopics.json"]
          },
          "validator": {
            "type": "jsonschema",
            "args": ["MediaWiki\\Extension\\UnifiedExtensionForFemiwiki\\GrowthExperiments\\TopicsSchema"]
          },
          "type": "data"
        }
      }
    }
  },
  "config": {
    "UnifiedExtensionForFemiwikiPreAuth": {
      "value": false,
      "description": "If set to true, creating account would require an additional step."
    },
    "UnifiedExtensionForFemiwikiModifyEmailTheme": {
      "value": false,
      "description": "Modifies the email theme to use the femiwiki theme."
    },
    "UnifiedExtensionForFemiwikiBlockByEmail": {
      "value": true,
      "description": "Block emails used by block users"
    },
    "UnifiedExtensionForFemiwikiSuggestedEdits": {
      "value": false,
      "description": "Finds GrowthExperiments suggested edits with database queries, without CirrusSearch or WikimediaMessages."
    },
    "UnifiedExtensionForFemiwikiManualNotificationBatchSize": {
      "value": 500,
      "description": "How many users one job of Special:WriteManualNotification notifies before queueing the next."
    },
    "UnifiedExtensionForFemiwikiExportTimeLimit": {
      "value": 20,
      "description": "Seconds after which Special:Export ends the document and points to the public dump. 0 turns the limit off."
    },
    "UnifiedExtensionForFemiwikiShareCard": {
      "value": false,
      "description": "Gives content pages without a page image a share card as og:image: the title and first paragraph drawn as PNG with GD and rsvg-convert. Turn $wgPageImagesOpenGraphFallbackImage off with it."
    },
    "UnifiedExtensionForFemiwikiShareCardFonts": {
      "value": {
        "regular": "/usr/local/share/fonts/pretendard/Pretendard-Regular.otf",
        "bold": "/usr/local/share/fonts/pretendard/Pretendard-Bold.otf",
        "han": "/usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc",
        "hanBold": "/usr/share/fonts/opentype/noto/NotoSansCJK-Bold.ttc",
        "family": "Pretendard, 'Noto Sans CJK KR', sans-serif"
      },
      "merge_strategy": "array_replace_recursive",
      "description": "Font files the share card measures text with: regular and bold, and han and hanBold for Hanja. family is the font-family list naming the same fonts to rsvg-convert, which finds them through fontconfig."
    },
    "UnifiedExtensionForFemiwikiRankingPages": {
      "value": [],
      "description": "Pages where a ranking bot lists users as links to their Special:Contributions. Users listed there by an account with the bot right earn an AchievementBadges badge. The badge exists only while this is not empty."
    }
  },
  "TestAutoloadNamespaces": {
    "MediaWiki\\Extension\\UnifiedExtensionForFemiwiki\\Tests\\Unit\\": "tests/phpunit/unit/",
    "MediaWiki\\Extension\\UnifiedExtensionForFemiwiki\\Tests\\Integration\\": "tests/phpunit/integration/"
  },
  "manifest_version": 2
}
